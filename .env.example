# phum-panya configuration — copy to `.env` and edit.
#   cp .env.example .env
# docker compose auto-loads `.env`. `.env` is gitignored; never commit real secrets.
#
# Prod (single embedded binary):  docker compose up
# Dev  (web + api split via nginx): docker compose -f docker-compose.dev.yaml up
# Both stacks read the same variables below (APP_HOST_PORT maps to nginx in dev).

# --- First admin (seeded once, on first run) --------------------------------
# The initial central-admin account. Change these before first launch.
APP_ADMIN_EMAIL=admin@example.com
# REQUIRED. Use a long, unique password — this is the only login until you
# create more users. compose refuses to start if this is empty.
APP_ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Networking / TLS -------------------------------------------------------
# Local/dev: plain HTTP. Set APP_DEV=1 and keep APP_DOMAIN empty.
APP_DEV=1
APP_HTTP_ADDR=:8080
# Host port that maps to the container's 8080. Change this if 8080 is already
# taken/reserved on your host (common on Windows/WSL2), e.g. APP_HOST_PORT=18080.
APP_HOST_PORT=8080
# Production TLS (built-in ACME / Let's Encrypt): comment out APP_DEV above,
# set your domain here, and publish ports 80 + 443 in docker-compose.yaml.
# The domain's DNS must point at this host and 80/443 must be reachable.
#APP_DOMAIN=example.org

# --- Storage (inside the /data volume) --------------------------------------
# SQLite DB file, uploaded media, and nightly backup zips. Defaults match the
# image; override only if you change the volume layout.
APP_DB_PATH=/data/app.db
APP_MEDIA_DIR=/data/media
APP_BACKUP_DIR=/data/backup
