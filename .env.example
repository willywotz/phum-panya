# phum-panya configuration — copy to `.env` and edit.
#   cp .env.example .env
# docker compose auto-loads `.env`. `.env` is gitignored; never commit real secrets.
#
# Prod (container stack — Caddy + web + api + Postgres): docker compose up -d --build
# Dev  (web + api split via nginx, hot reload):          docker compose -f docker-compose.dev.yaml up -w
#
# The prod stack derives the api's runtime vars (APP_DB_DRIVER, APP_DATABASE_URL,
# APP_BEHIND_PROXY, APP_PUBLIC_ORIGIN, APP_MEDIA_DIR) inside docker-compose.yaml
# from the values below — you only set the secrets and the domain here.
#
# The prod stack runs DB migration as a one-shot `migrate` job before the api
# replicas start; the api runs with APP_AUTO_MIGRATE=false. The single binary
# leaves APP_AUTO_MIGRATE at its default (true) and migrates on startup.

# --- First admin (seeded once, on first run) --------------------------------
# The initial central-admin account. Change these before first launch.
APP_ADMIN_EMAIL=admin@example.com
# REQUIRED. Use a long, unique password — this is the only login until you
# create more users. compose refuses to start if this is empty.
APP_ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Prod stack: domain + Postgres (docker-compose.yaml) --------------------
# Caddy gets a Let's Encrypt cert for this domain and serves HTTPS on 80/443.
# The domain's DNS A record must point at this host and 80/443 must be reachable.
APP_DOMAIN=example.org
# Postgres has defaults (phumpanya / phumpanya); POSTGRES_PASSWORD is REQUIRED.
POSTGRES_DB=phumpanya
POSTGRES_USER=phumpanya
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Dev stack only (docker-compose.dev.yaml) -------------------------------
# Dev mirrors prod: same Caddy proxy + Postgres, api in behind-proxy mode, only
# web/api run in hot-reload mode. POSTGRES_* above are reused (POSTGRES_PASSWORD
# defaults to a dev value if unset). Host port that maps to Caddy — change if
# 8080 is taken/reserved on your host (common on Windows/WSL2), e.g. 18080.
APP_HOST_PORT=8080

# --- Media object storage (prod + dev stacks: Garage) ----------------------
# The api stores uploads in an internal Garage bucket over the S3 API; Caddy
# proxies /media/* to the api, which streams the bytes. Garage has no public
# port. garage-init imports THIS exact key so the api can authenticate.
# Garage v1.0.1 enforces the key format below; `garage key import` fails on
# other formats.
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=change-me-to-a-64-hex-char-secret
# "GK" + 24 hex chars. Generate: echo "GK$(openssl rand -hex 12)"
APP_S3_ACCESS_KEY=change-me-access-key
# 64 hex chars (32 bytes). Generate: openssl rand -hex 32
APP_S3_SECRET_KEY=change-me-to-a-long-random-secret
APP_S3_BUCKET=media

# --- Telemetry (optional tuning) -------------------------------------------
# Structured logs go to stdout as JSON. Level: debug|info|warn|error.
APP_LOG_LEVEL=info
# Traces: the prod/dev stacks send OTLP to the bundled Jaeger; view them at
# https://<domain>/traces (central-admin login required).
