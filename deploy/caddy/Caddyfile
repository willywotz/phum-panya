# deploy/caddy/Caddyfile — one public origin; TLS via Caddy's ACME.
{$APP_DOMAIN} {
	encode gzip

	# API → the Go service.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Media reads are streamed by the Go service from object storage; Caddy
	# proxies them like the rest of the API.
	handle /media/* {
		reverse_proxy api:8080
	}

	# Jaeger trace UI, gated to central-admin sessions via the api.
	handle /traces* {
		forward_auth api:8080 {
			uri /api/authorization/verify-admin
			copy_headers Cookie
		}
		reverse_proxy jaeger:16686
	}

	# Everything else → the Next.js standalone service.
	handle {
		reverse_proxy web:3000
	}
}
